{
  "name": "gb7714-parser",
  "version": "0.1.0",
  "description": "GB/T 7714 reference citation parser for Chinese academic papers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gb7714",
    "gb/t-7714",
    "citation",
    "reference",
    "parser",
    "chinese",
    "academic",
    "bibliography"
  ],
  "author": "Axetroy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axetroy/gb7714-parser.git"
  },
  "bugs": {
    "url": "https://github.com/axetroy/gb7714-parser/issues"
  },
  "homepage": "https://github.com/axetroy/gb7714-parser#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
